# Mentorship interest form (mentor.mphinance.com). Stdlib server on docker0 IP;
# Traefik route at /data/coolify/proxy/dynamic/mentor.yml.
[Unit]
Description=Mentorship interest form (mentor.mphinance.com :8772)

[Service]
Type=simple
WorkingDirectory=/home/mph/mphinance/tools/mentor_interest
ExecStart=/usr/bin/python3 -u /home/mph/mphinance/tools/mentor_interest/server.py
EnvironmentFile=/home/mph/.config/mentor-interest/env
Environment=MENTOR_BIND=10.0.0.1
Environment=MENTOR_PORT=8772
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
