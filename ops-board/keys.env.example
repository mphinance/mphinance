# Ops Board — local keys. Copy to `keys.env` and fill in BEFORE first boot.
# This file lives only on the Pi. The kiosk browser never reads it — refresh.py
# uses it server-side and writes data.json (which contains no secrets).
#
#   cp keys.env.example keys.env   &&   nano keys.env
#
# keys.env is gitignored. Never commit real keys.

# Tradier — real-time market data: index band, SPY hero-chart candles, and the
# live SPY price tap (/api/spy). Market data only — no account/positions access.
# Get a token at https://dash.tradier.com (Settings → API Access).
# A funded brokerage token gives real-time data; sandbox is 15-min delayed.
TRADIER_TOKEN=
# TRADIER_BASE=https://sandbox.tradier.com   # uncomment for paper/sandbox

# TraderDaddy Pro — flow tape, convergence, gamma pin map, sentiment.
TD_API_KEY=
